# --- Сервер ---
PORT=4000
NODE_ENV=development

# --- Database (PostgreSQL) ---
# Render/Railway зэрэг hosting ашиглах бол DATABASE_URL-ийг бөглөнө (доор тайлбарласан).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minimal_shop
DATABASE_SSL=false

# Local PostgreSQL ашиглах бол (DATABASE_URL хоосон үед ашиглагдана)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=minimal_shop

# --- JWT ---
# Random, урт нууц түлхүүр ашиглана уу. Жишээ нь: openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_secret_string

# --- CORS ---
# Frontend-ийн URL (production дээр Vercel-ийн домэйноор солино)
CORS_ORIGIN=http://localhost:5173

# --- Upload ---
# Зураг base64 хэлбэрээр шууд Database-д хадгалагддаг тул local disk/cloud
# storage шаардлагагүй. PUBLIC_BASE_URL зөвхөн хуучин (local disk-д хадгалагдсан)
# зургуудын замд ашиглагдана.
PUBLIC_BASE_URL=http://localhost:4000

# --- Seed script ---
SEED_ADMIN_EMAIL=admin@minimalshop.mn
SEED_ADMIN_PASSWORD=Admin12345!

# --- Захиалгын имэйл мэдэгдэл (заавал биш) ---
# Хоёуланг нь бөглөвөл шинэ захиалга ирэх бүрд GMAIL_USER-ээс имэйл мэдэгдэл
# явна. Google акаунтын Settings > Security > 2-Step Verification идэвхжүүлсний
# дараа "App passwords" хэсгээс 16 тэмдэгтийн нууц үг үүсгэж GMAIL_APP_PASSWORD-д
# оруулна (энгийн Google нэвтрэх нууц үгээ биш!).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Мэдэгдэл өөр имэйл рүү явуулах бол (хоосон бол GMAIL_USER рүүгээ явна)
NOTIFY_EMAIL=

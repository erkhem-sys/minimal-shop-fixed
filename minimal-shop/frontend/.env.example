# API серверийн хаяг — local дээр ажиллахад
VITE_API_URL=http://localhost:4000/api

# Production дээр (Render/Railway-д deploy хийсэн backend URL)
# VITE_API_URL=https://your-backend.onrender.com/api

# Google Analytics 4 measurement ID (жишээ: G-XXXXXXXXXX) — заавал биш,
# байхгүй бол GA код огт ачаалагдахгүй
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Facebook (Meta) Pixel ID — заавал биш, байхгүй бол pixel код огт ачаалагдахгүй
# VITE_FB_PIXEL_ID=000000000000000
